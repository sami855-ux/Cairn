{
  "name": "@samux855/cairn",
  "version": "1.1.0",
  "description": "Scans configured Git repositories daily and safely commits and pushes real changes",
  "type": "module",
  "bin": {
    "cairn": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^18.0.8",
    "picocolors": "^1.1.1",
    "simple-git": "^4.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
